# Build and test the C++ protocol: docker build -f protocol/cpp/Dockerfile.test protocol
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libssl-dev nlohmann-json3-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY test-vectors.json ./test-vectors.json
COPY cpp ./cpp
RUN cmake -S cpp -B build -DBUILD_TESTING=ON && cmake --build build --parallel && ctest --test-dir build --output-on-failure
