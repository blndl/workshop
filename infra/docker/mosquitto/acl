# alarm-core ("hub"): talks to the nodes, takes control requests, publishes
# state and events for the other services.
user hub
topic readwrite alarm/v1/#
topic read alarm/control
topic write alarm/events
topic write alarm/state
topic read alarm/snapshots

# Control client (dev CLI now, the API service later).
user ctl
topic write alarm/control
topic read alarm/events
topic read alarm/state

# Web API (services/api): reads state and events, sends control requests.
user api
topic write alarm/control
topic read alarm/events
topic read alarm/state
# DEV ONLY: the dashboard's simulator panel drives the fake nodes.
topic write sim/+/cmd
topic read sim/+/status

# Camera service: follows the alarm, announces each picture it stores.
user camera
topic read alarm/events
topic read alarm/state
topic write alarm/snapshots

# Notifier: follows the alarm, sends phone alerts.
user notifier
topic read alarm/events
topic read alarm/state

# DEV ONLY: simulates an attacker who sniffed broker credentials off the
# Wi-Fi (MQTT is plain TCP). Remove this block on a real deployment.
user attacker
topic readwrite alarm/v1/#

# Each node: write its own uplink and status, read its own downlink.
pattern write alarm/v1/%u/up
pattern write alarm/v1/%u/status
pattern read alarm/v1/%u/down

# DEV ONLY: simulated nodes take dashboard commands and report what they do.
# A real ESP has no such channel. Remove these two lines on a real deployment.
pattern read sim/%u/cmd
pattern write sim/%u/status
