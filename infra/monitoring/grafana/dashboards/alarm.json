    {
      "type": "timeseries",
      "title": "Alarms and attacks over time",
      "id": 23,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(event_time, $__interval),\n  count(*) FILTER (WHERE event_type = 'state' AND event_data->>'state' = 'triggered') AS \"alarms\",\n  count(*) FILTER (WHERE event_type = 'security') AS \"rejected messages\",\n  count(*) FILTER (WHERE event_type = 'bad_code') AS \"wrong codes\"\nFROM alarm_events WHERE $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1m"
    },
