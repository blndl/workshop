          },
          "rawSql": "SELECT event_time AS \"time\", seq, event_type AS \"type\", event_data->>'node' AS \"module\",\n  coalesce(event_data->>'state', event_data->>'sensor', event_data->>'kind', event_data->>'reason', '') AS \"detail\"\nFROM alarm_events WHERE $__timeFilter(event_time) ORDER BY seq DESC NULLS LAST LIMIT 100",
