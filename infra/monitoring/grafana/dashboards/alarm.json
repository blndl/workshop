          },
          "rawSql": "SELECT event_data->>'node' AS \"module\", event_data->>'kind' AS \"kind\", count(*) AS \"count\", max(event_time) AS \"last\"\nFROM alarm_events WHERE event_type = 'security' AND $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 3 DESC",
