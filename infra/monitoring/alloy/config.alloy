// Grafana Alloy: collects the alarm containers' logs and sends them to Loki.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "alarm" {
  targets = []

  // Only this project's containers.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "alarm"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "alarm" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.alarm.rules
  forward_to    = [loki.process.privacy.receiver]
}

// A forced (duress) disarm must not be visible to whoever can read the logs.
loki.process "privacy" {
  stage.drop {
    expression = "(?i)duress"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
